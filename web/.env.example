# FIREBASE PUBLIC CLIENT CONFIGURATION (Browser)
# Dapatkan dari: Firebase Console -> Project Settings -> General -> Your Apps (Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyFakeKeyForTemplateOnly_Example123
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=smart-dispenser-ukl3.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://smart-dispenser-ukl3-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=smart-dispenser-ukl3
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# FIREBASE ADMIN SDK PRIVATE CREDENTIALS (Server-Side Only)
# Dapatkan dari: Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_ADMIN_PROJECT_ID=smart-dispenser-ukl3
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@smart-dispenser-ukl3.iam.gserviceaccount.com
# Gunakan tanda petik ganda untuk PRIVATE_KEY agar format \n terbaca dengan benar:
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# HARDWARE DEVICE AUTHENTICATION SECRET
# SHA-256 hash dari DEVICE_SECRET_TOKEN yang disimpan di secrets.py ESP32.
# Contoh: Token "sija_dispenser_super_secret_token_2026" menghasilkan SHA-256:
DEVICE_TOKEN_SHA256=03ff1e2465f3e6d9030703ff2b76b936221ccdb169bde59e3364f7e6d8f83cbd

# DEFAULT DEVICE ID
DEFAULT_DEVICE_ID=dispenser01

# SESSION AUTHENTICATION SECRET
SESSION_SECRET=sija_jwt_session_secret_change_in_production_2026
